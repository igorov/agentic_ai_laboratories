LOG_LEVEL=DEBUG

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
QDRANT_URL=
QDRANT_KEY=
QDRANT_COLLECTION_NAME=

NEON_API_KEY=
NEON_PROJECT_ID=

# Máximo de llamadas al modelo por invocación (hook pre_model)
MAX_MODEL_CALLS=10

# Groq (Guardrails — Capas 7 y 8: Llama Prompt Guard 2 y gpt-oss-safeguard)
GROQ_API_KEY=
GROQ_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
GROQ_LLAMA_GUARD_MODEL=openai/gpt-oss-safeguard-20b
GROQ_TIMEOUT_SECONDS=3

# Guardrails — Capa 4 (timeout anti-ReDoS por regla, en segundos)
CUSTOM_REGEX_TIMEOUT_SECONDS=1

# Prompts versionados (prompts/system/{PROMPT_VERSION}.md)
PROMPT_VERSION=v1

# LangSmith — tracing, costos y feedback
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
